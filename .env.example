# Copy to .env next to docker-compose.yml on the deploy host. Never commit the real .env.
POSTGRES_USER=lims
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lims

# Optional: read-only Multi-LIMS Warehouse connection (MySQL, always over TLS). Leave empty to
# run without MLWH. Use a read-only login.
MLWH_DATABASE_URL=
MLWH_PASSWORD=
MLWH_SSL_CA=
MLWH_SSL_VERIFY=true
